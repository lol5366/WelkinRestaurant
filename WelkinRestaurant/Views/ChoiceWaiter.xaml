<Window x:Class="WelkinRestaurant.Views.ChoiceWaiter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Передача стола" 
        Height="250" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ПЕРЕДАЧА СТОЛА" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"
                   Foreground="#0078D4"/>

        <TextBlock Grid.Row="1" Text="Выберите официанта:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbWaiters" Grid.Row="2" Height="32" Margin="0,0,0,20" DisplayMemberPath="Text" SelectedValuePath="Tag"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="ПЕРЕДАТЬ" Width="100" Height="32" Click="Transfer_Click" Background="#0078D4" Foreground="White"/>
            <Button Content="ОТМЕНА" Width="100" Height="32" Margin="10,0,0,0" Click="Cancel_Click" Background="#3D3D3D" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>