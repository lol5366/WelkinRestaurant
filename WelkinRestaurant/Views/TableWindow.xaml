<Window x:Class="WelkinRestaurant.Views.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welkin Restaurant - Стол" 
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <!-- Стиль для всех ComboBox в этом окне -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль для элементов выпадающего списка -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E8ADC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <!-- Шире для заказа -->
            <ColumnDefinition Width="2*"/>
            <!-- Уже для меню -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая часть - заказ (шире) -->
        <Border Grid.Column="0" Grid.Row="0" Background="#252525" CornerRadius="6" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#2D2D2D" Padding="12,10" CornerRadius="6,6,0,0">
                    <TextBlock Text="ТЕКУЩИЙ ЗАКАЗ" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

                <ListView x:Name="lvOrderItems" Grid.Row="1" Margin="12" 
                          Background="#252525"
                          Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="БЛЮДО" Width="220" DisplayMemberBinding="{Binding ItemName}"/>
                            <GridViewColumn Header="КОЛ-ВО" Width="80" DisplayMemberBinding="{Binding Quantity}"/>
                            <GridViewColumn Header="СУММА" Width="100" DisplayMemberBinding="{Binding Total}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Правая часть - меню -->
        <Border Grid.Column="1" Grid.Row="0" Background="#252525" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#2D2D2D" Padding="12,10" CornerRadius="6,6,0,0">
                    <TextBlock Text="МЕНЮ" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

                <TabControl Grid.Row="1" Margin="12" Background="#252525" BorderBrush="#3D3D3D">
                    <TabItem Header="ПАСТЫ" Foreground="White" Background="#2D2D2D">
                        <ListBox x:Name="lstPastas" Background="#252525" Foreground="White" BorderBrush="#3D3D3D"
                                 SelectionChanged="MenuItem_Selected"/>
                    </TabItem>
                    <TabItem Header="СУПЫ" Foreground="White" Background="#2D2D2D">
                        <ListBox x:Name="lstSoups" Background="#252525" Foreground="White" BorderBrush="#3D3D3D"
                                 SelectionChanged="MenuItem_Selected"/>
                    </TabItem>
                    <TabItem Header="ГОРЯЧЕЕ" Foreground="White" Background="#2D2D2D">
                        <ListBox x:Name="lstHotDishes" Background="#252525" Foreground="White" BorderBrush="#3D3D3D"
                                 SelectionChanged="MenuItem_Selected"/>
                    </TabItem>
                    <TabItem Header="НАПИТКИ" Foreground="White" Background="#2D2D2D">
                        <ListBox x:Name="lstDrinks" Background="#252525" Foreground="White" BorderBrush="#3D3D3D"
                                 SelectionChanged="MenuItem_Selected"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Нижняя панель -->
        <Border Grid.ColumnSpan="2" Grid.Row="1" Background="#252525" CornerRadius="6" Margin="0,10,0,0" Padding="12,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="btnSave" Content="СОХРАНИТЬ" Width="100" Height="32" Click="Save_Click"/>
                    <Button x:Name="btnEdit" Content="РЕДАКТИРОВАТЬ" Width="120" Height="32" Margin="8,0,0,0" Click="Edit_Click"/>
                    <Button x:Name="btnCancelEdit" Content="ОТМЕНИТЬ" Width="100" Height="32" Margin="8,0,0,0" Click="CancelEdit_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnSplitBill" Content="РАЗДЕЛИТЬ" Width="100" Height="32" Margin="8,0,0,0" Click="SplitBill_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnCheck" Content="ОПЛАТИТЬ" Width="100" Height="32" Margin="8,0,0,0" Click="Check_Click"/>
                    <Button x:Name="btnTransferTable" 
        Content="СМЕНИТЬ ОФИЦИАНТА" 
        Width="140" Height="32" 
        Margin="8,0,0,0" 
        Click="TransferTable_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="ИТОГО:" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="txtTotal" FontSize="20" FontWeight="SemiBold" Foreground="#107C10"/>
                    <TextBlock Text=" RUB" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>