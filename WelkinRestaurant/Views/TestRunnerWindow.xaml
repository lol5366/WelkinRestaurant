<Window x:Class="WelkinRestaurant.Views.TestRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welkin - Тестирование системы" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="СИСТЕМНОЕ ТЕСТИРОВАНИЕ WELKIN" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"
                   Foreground="#0078D4"/>

        <!-- Кнопки тестов (с прокруткой, если не помещаются) -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled"
                      MaxHeight="80"
                      Margin="0,0,0,15">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="🧪 ВСЕ ТЕСТЫ" 
                        Width="130" Height="35" 
                        Margin="5" 
                        Click="RunAllTests_Click"
                        Background="#0078D4" 
                        Foreground="White"/>
                <Button Content="🔐 ТЕСТ РОЛЕЙ" 
                        Width="130" Height="35" 
                        Margin="5" 
                        Click="RunRoleTests_Click"
                        Background="#333333" 
                        Foreground="White"/>
                <Button Content="✏️ ТЕСТ РЕДАКТИРОВАНИЯ" 
                        Width="150" Height="35" 
                        Margin="5" 
                        Click="RunEditTests_Click"
                        Background="#333333" 
                        Foreground="White"/>
                <Button Content="💾 ТЕСТ СОХРАНЕНИЯ" 
                        Width="140" Height="35" 
                        Margin="5" 
                        Click="RunSaveTests_Click"
                        Background="#333333" 
                        Foreground="White"/>
                <Button Content="💰 ТЕСТ ОПЛАТЫ" 
                        Width="130" Height="35" 
                        Margin="5" 
                        Click="RunPaymentTests_Click"
                        Background="#333333" 
                        Foreground="White"/>
                <Button Content="📊 ТЕСТ ОТЧЁТОВ" 
                        Width="130" Height="35" 
                        Margin="5" 
                        Click="RunReportTests_Click"
                        Background="#333333" 
                        Foreground="White"/>
                <Button Content="📦 ТЕСТ ОСТАТКОВ" 
                        Width="130" Height="35" 
                        Margin="5" 
                        Click="RunStockTests_Click"
                        Background="#333333" 
                        Foreground="White"/>
            </WrapPanel>
        </ScrollViewer>

        <!-- Область вывода результатов (с прокруткой) -->
        <Border Grid.Row="2" Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="resultsScrollViewer" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          Background="#252525">
                <TextBox x:Name="txtResults" 
                         FontFamily="Consolas" 
                         FontSize="11"
                         Background="#252525"
                         Foreground="#CCCCCC"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Padding="15"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="3" 
                Content="ЗАКРЫТЬ" 
                Width="100" Height="35" 
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="Close_Click"
                Background="#3D3D3D" 
                Foreground="White"/>
    </Grid>
</Window>