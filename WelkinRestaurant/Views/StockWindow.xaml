<Window x:Class="WelkinRestaurant.Views.StockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление остатками" 
        Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="УПРАВЛЕНИЕ ОСТАТКАМИ ПРОДУКТОВ" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"
                   Foreground="#0078D4"/>
        
        <DataGrid x:Name="dgProducts" 
                  Grid.Row="1" 
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="#252525"
                  Foreground="White"
                  BorderBrush="#3D3D3D"
                  HeadersVisibility="Column"
                  RowBackground="#252525"
                  AlternatingRowBackground="#2D2D2D"
                  GridLinesVisibility="Horizontal">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ед.изм" Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Мин.остаток" Binding="{Binding MinQuantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button Content="СОХРАНИТЬ" Width="120" Height="35" Margin="5" Click="Save_Click" Background="#107C10" Foreground="White"/>
            <Button Content="ОБНОВИТЬ" Width="100" Height="35" Margin="5" Click="Refresh_Click" Background="#0078D4" Foreground="White"/>
            <Button Content="ЗАКРЫТЬ" Width="100" Height="35" Margin="5" Click="Close_Click" Background="#3D3D3D" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>