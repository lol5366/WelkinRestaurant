<Window x:Class="WelkinRestaurant.Views.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники и их столы" 
        Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="СОТРУДНИКИ РЕСТОРАНА" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"
                   Foreground="#0078D4"/>

        <DataGrid x:Name="dgEmployees" Grid.Row="1" 
                  AutoGenerateColumns="False"
                  Background="#252525"
                  Foreground="White"
                  BorderBrush="#3D3D3D"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  RowBackground="#252525"
                  AlternatingRowBackground="#2D2D2D"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding FullName}" Width="180"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                <DataGridTextColumn Header="Активных столов" Binding="{Binding TablesCount}" Width="130"/>
                <DataGridTextColumn Header="Номера столов" Binding="{Binding TableNumbers}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="ЗАКРЫТЬ" Width="100" Height="32" 
                HorizontalAlignment="Center" Margin="0,15,0,5"
                Click="Close_Click" Background="#3D3D3D" Foreground="White"/>
    </Grid>
</Window>