<Window x:Class="WelkinRestaurant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welkin Restaurant - Управление залами" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        MinHeight="600" MinWidth="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Столы -->
            <ColumnDefinition Width="280"/>
            <!-- Панель действий -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="*"/>
            <!-- Основное содержание -->
            <RowDefinition Height="25"/>
            <!-- Подпись -->
            <RowDefinition Height="30"/>
            <!-- Статус-бар -->
        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- Верхняя панель (на всю ширину) -->
        <!-- ======================================================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="WELKIN" 
                           FontSize="18" 
                           FontWeight="Light"
                           VerticalAlignment="Center"
                           Foreground="#0078D4"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserInfo" 
                               Foreground="#CCCCCC" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <Button Content="ВЫХОД" 
                            Click="Logout_Click"
                            Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================= -->
        <!-- ЛЕВАЯ ЧАСТЬ: План столов -->
        <!-- ======================================================= -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="panelTables" 
                   Margin="20" 
                   Background="#1E1E1E" 
                   HorizontalAlignment="Center"
                   Orientation="Horizontal"
                   Width="Auto"/>
            </ScrollViewer>
        </Border>

        <!-- ======================================================= -->
        <!-- ПРАВАЯ ЧАСТЬ: Панель действий -->
        <!-- ======================================================= -->
        <Border Grid.Row="1" Grid.Column="1" Background="#252525">
            <StackPanel Margin="15">

                <!-- Заголовок -->
                <Border x:Name="rightPanel" Background="#2D2D2D" CornerRadius="6" Padding="12,8" Margin="0,0,0,15">
                    <TextBlock Text="ДЕЙСТВИЯ" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#0078D4"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Кнопки действий -->
                <Button x:Name="btnEmployees" 
                        Content="СОТРУДНИКИ" 
                        Click="Employees_Click"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#2D2D2D"
                        Foreground="White"
                        Visibility="Collapsed"/>
                


                <Button x:Name="btnStock" 
                        Content="УПРАВЛЕНИЕ ОСТАТКАМИ" 
                        Click="Stock_Click"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#2D2D2D"
                        Foreground="White"
                        Visibility="Collapsed"/>

                <Button x:Name="btnCloseShift" 
                        Content="ЗАКРЫТЬ СМЕНУ" 
                        Click="CloseShift_Click"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#2D2D2D"
                        Foreground="White"
                        Visibility="Collapsed"/>

                <Button x:Name="btnFunctionalTests" 
                        Content="ТЕСТИРОВАНИЕ" 
                        Click="OpenTests_Click"
                        Height="40"
                        Margin="0,0,0,8"
                        Background="#2D2D2D"
                        Foreground="White"
                        Visibility="Collapsed"/>

                <!-- Разделитель -->
                <Border Height="1" Background="#333333" Margin="0,15,0,15"/>

                <!-- Информационный блок -->
                <Border Background="#2D2D2D" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ИНФОРМАЦИЯ" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Всего столов:" Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtTotalTables" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,8"/>

                        <TextBlock Text="Свободных столов:" Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtFreeTables" Foreground="#00CC66" FontSize="13" Margin="0,0,0,8"/>

                        <TextBlock Text="Занятых столов:" Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtOccupiedTables" Foreground="#E81123" FontSize="13" Margin="0,0,0,8"/>

                        <TextBlock Text="Выручка за сегодня:" Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtTodayRevenue" Foreground="#0078D4" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ======================================================= -->
        <!-- Подпись (на всю ширину) -->
        <!-- ======================================================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1E1E1E">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="© 2025 Welkin Restaurant" Foreground="#555555" FontSize="10" Margin="0,0,15,0"/>
                <TextBlock Text="|" Foreground="#444444" FontSize="10" Margin="0,0,15,0"/>
                <TextBlock Text="Версия 2.0" Foreground="#555555" FontSize="10" Margin="0,0,15,0"/>
                <TextBlock Text="|" Foreground="#444444" FontSize="10" Margin="0,0,15,0"/>
                <TextBlock Text="Автоматизированная система управления рестораном" Foreground="#555555" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- ======================================================= -->
        <!-- Статус-бар (на всю ширину) -->
        <!-- ======================================================= -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserStatus" Foreground="#CCCCCC" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtDateStatus" Foreground="#888888" FontSize="11" Margin="0,0,15,0"/>
                    <TextBlock x:Name="txtTimeStatus" Foreground="#888888" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>