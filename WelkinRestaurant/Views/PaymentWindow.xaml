<Window x:Class="WelkinRestaurant.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welkin Restaurant - Оплата" 
        Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="#252525" CornerRadius="8">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ОПЛАТА ЗАКАЗА" 
                       FontSize="16" 
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,24"/>

            <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="6" Padding="16" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="СУММА:" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtAmount" FontSize="24" FontWeight="SemiBold" Foreground="#107C10"/>
                    <TextBlock Text=" RUB" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="СПОСОБ ОПЛАТЫ" FontSize="11" Foreground="#888888" Margin="0,0,0,6"/>
            <ComboBox x:Name="cmbPaymentType" Grid.Row="2" Height="36" SelectedIndex="0">
                <ComboBoxItem>НАЛИЧНЫЕ</ComboBoxItem>
                <ComboBoxItem>БАНКОВСКАЯ КАРТА</ComboBoxItem>
                <ComboBoxItem>СБП</ComboBoxItem>
            </ComboBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                <Button Content="ОПЛАТИТЬ" Width="120" Click="Pay_Click" Background="#107C10"/>
                <Button Content="ОТМЕНА" Width="100" Margin="12,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>